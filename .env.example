# MALA JUNTA — variables de entorno
# Copia este archivo como ".env" y rellena con los datos de tu proyecto Supabase.
# (Supabase → Project Settings → API)
# Sin estas variables, la web arranca en modo demostración con datos estáticos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
